generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum UserRole {
  OWNER
  COLLABORATOR
  VIEWER
}

enum Plan {
  FREE
  PRO
}

enum SubscriptionTier {
  FREE
  SOLO
  STUDIO
}

enum StudioCreationStatus {
  DRAFT
  ANALYSIS_QUEUED
  ANALYSING
  MASTER_PROMPT_READY
  GENERATION_QUEUED
  GENERATING
  COMPLETED
  FAILED
  CANCELLED
}

enum StudioAssetKind {
  REFERENCE
  IDENTITY
  RESULT
}

enum StudioJobKind {
  ANALYZE
  GENERATE
  PURGE
}

enum StudioJobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum StudioCreditEntryKind {
  ACTIVATION_GRANT
  SUBSCRIPTION_GRANT
  RESERVATION
  ANALYSIS_DEBIT
  RESERVATION_RELEASE
  COMPENSATION
  PURCHASE
  EXPIRATION
}

enum StudioCreditLotKind {
  ACTIVATION
  SUBSCRIPTION
  PURCHASE
  COMPENSATION
  MIGRATION
}

enum StudioCreditAllocationState {
  RESERVED
  DEBITED
  RELEASED
}

enum MacroState {
  SYSTEM_READY
  DASHBOARD
  WORKSPACE_IDLE
  SUBFOLDER_OPEN
  CARD_FLOW
  EXPERT_FLOW
  SCORE_UPDATE
  LAB_TRANSITION
  EXPORT
  CROWDFUNDING
}

enum SubFolderType {
  PRODUIT
  MARCHE
  TECHNOLOGIE
  BUSINESS
}

enum LabType {
  DISCOVERY
  STRUCTURATION
  VALIDATION_MARCHE
  DESIGN_PRODUIT
  ARCHITECTURE_TECHNIQUE
  BUSINESS_FINANCE
}

enum CardState {
  DRAFT
  VALIDATED
  REJECTED
  ARCHIVED
}

enum ExpertSessionStatus {
  PENDING
  WAITING_VALIDATION
  VALIDATED
  REJECTED
}

enum ExportState {
  LOCKED
  ELIGIBLE
  GENERATING
  READY
  FAILED
}

enum CrowdfundingState {
  LOCKED
  ELIGIBLE
  ACTIVE
  CLOSED
}

enum InvestmentStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum PoleCode {
  P01_STRATEGIE
  P02_MARKET
  P03_PRODUIT_TECH
  P04_FINANCE
  P05_MARKETING
  P06_LEGAL
  P07_TALENT_OPS
}

enum PoleSessionStatus {
  ACTIVE
  COMPLETED
  FAILED
}

enum MissionStatus {
  BRIEFING
  PENDING
  RUNNING
  DONE
  FAILED
  CANCELLED
}

enum DocumentType {
  ANALYSIS
  REPORT
  STACK
  PROJECTION
  RESEARCH
  SOURCE_FILE
}

enum TaskStatus {
  SUGGESTED
  PLANNED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum CardType {
  IDEA
  DECISION
  TASK
  ANALYSIS
  HYPOTHESIS
  PROBLEM
  VISION
}

enum CardSource {
  USER
  EXPERT
  SYSTEM
}

enum RelationType {
  DERIVED_FROM
  SUPPORTS
  IMPLEMENTS
  REFINES
  RELATES_TO
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  role      UserRole @default(OWNER)
  createdAt DateTime @default(now())

  coreUserId          String?  @unique @map("core_user_id")
  firstName           String?
  lastName            String?
  company             String?
  industry            String?
  goal                String?
  avatarUrl           String?
  onboardingCompleted Boolean @default(false)
  // Legacy — remplacé par le système hybride abonnement + top-up
  missionBudget       Int     @default(5)
  plan                Plan    @default(FREE)

  // Nouveau modèle économique
  subscriptionTier        SubscriptionTier @default(FREE)
  stripeCustomerId        String?          @unique
  stripeSubscriptionId    String?          @unique
  subscriptionStatus      String?          // "active" | "canceled" | "past_due"
  monthlyMissionAllowance Int              @default(5)   // missions incluses dans l'abonnement (renouvelées chaque mois)
  monthlyMissionsUsed     Int              @default(0)   // missions abonnement consommées ce mois
  topUpMissions           Int              @default(0)   // missions achetées en top-up (permanentes, jamais expirées)
  allowanceResetAt        DateTime?                      // prochain reset mensuel
  studioCredits           Int              @default(0)
  preferences         Json    @default("{}")

  referralCode    String? @unique
  referredById    String?
  referredBy      User?        @relation("UserToReferral", fields: [referredById], references: [id])
  referrals       User[]       @relation("UserToReferral")
  referralLogs    ReferralLog[] @relation("ReferralLogUser")
  ambassadorLogs  ReferralLog[] @relation("ReferralLogAmbassador")

  dossiers             Dossier[]
  auditLogs            AuditLog[]
  cardTransitionLogs   CardTransitionLog[]
  notificationSettings UserNotificationSettings?
  studioCreations      StudioCreation[]
  studioAssets         StudioAsset[]
  studioConsents       StudioConsent[]
  studioCreditLedger   StudioCreditLedger[]
  studioCreditLots     StudioCreditLot[]
  studioSubscription   StudioSubscription?
  studioPushSubscriptions StudioPushSubscription[]
  studioProfiles       StudioProfile[]
  studioIdentityProfile StudioIdentityProfile?
  studioIdentityAssets StudioIdentityAsset[]
  studioIdentityManifests StudioIdentityManifest[]
  studioIdentityEvaluations StudioIdentityEvaluation[]
  studioConsentEvents StudioConsentEvent[]
  studioSessions       StudioSession[]
}

model ReferralLog {
  id           String   @id @default(cuid())
  userId       String
  ambassadorId String
  type         String   // "SIGNUP", "ACTIVATED"
  missions     Int      // Nombre de missions créditées
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())

  user     User? @relation("ReferralLogUser", fields: [userId], references: [id], onDelete: Cascade)
  ambassador User? @relation("ReferralLogAmbassador", fields: [ambassadorId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ambassadorId])
}

model Dossier {
  id                  String     @id @default(cuid())
  name                String
  ownerId             String
  macroState          MacroState @default(WORKSPACE_IDLE)
  archived            Boolean    @default(false)
  onboardingMessages  Json       @default("[]")
  onboardingState     Json?
  tags                String[]   @default([])
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  owner                User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  subFolders           SubFolder[]
  cards                Card[]
  labState             LabState?
  scoreSnapshots       ScoreSnapshot[]
  exportRecord         ExportRecord?
  crowdfundingCampaign CrowdfundingCampaign?
  expertSessions       ExpertSession[]
  poleSessions         PoleSession[]
  missions             Mission[]
  auditLogs            AuditLog[]
  cardIngestionLogs    CardIngestionLog[]
  cardIngestionJobs    CardIngestionJob[]
  kaelSessions         KaelSession[]
  autonomousMissions   AutonomousMission[]
  expertDocuments      ExpertDocument[]
  tasks                Task[]
  studioCreations      StudioCreation[]

  @@index([ownerId])
  @@index([archived])
}

model SubFolder {
  id        String        @id @default(cuid())
  dossierId String
  type      SubFolderType
  createdAt DateTime      @default(now())

  dossier     Dossier      @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  cards       Card[]
  canvasNodes CanvasNode[]
  canvasEdges CanvasEdge[]

  @@unique([dossierId, type])
  @@index([dossierId])
}

model LabState {
  id                String   @id @default(cuid())
  dossierId         String   @unique
  currentLab        LabType  @default(DISCOVERY)
  transitionAllowed Boolean  @default(false)
  updatedAt         DateTime @updatedAt

  dossier        Dossier         @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  expertSessions ExpertSession[]
}

model Card {
  id          String      @id @default(cuid())
  subFolderId String?
  dossierId   String?
  lab         LabType?
  type        String?
  cardType    CardType?
  title       String
  content     Json        @default("{}")
  state       CardState   @default(DRAFT)
  source      CardSource  @default(USER)
  poleCode    PoleCode?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  subFolder         SubFolder?          @relation(fields: [subFolderId], references: [id], onDelete: Cascade)
  dossier           Dossier?            @relation(fields: [dossierId], references: [id], onDelete: SetNull)
  transitionLogs    CardTransitionLog[]
  expertSessions    ExpertSession[]
  outgoingRelations CardRelation[]      @relation("fromCard")
  incomingRelations CardRelation[]      @relation("toCard")

  @@index([subFolderId])
  @@index([dossierId])
  @@index([lab])
  @@index([state])
  @@index([poleCode])
}

model CardRelation {
  id         String       @id @default(cuid())
  fromCardId String
  toCardId   String
  type       RelationType
  createdAt  DateTime     @default(now())

  fromCard Card @relation("fromCard", fields: [fromCardId], references: [id], onDelete: Cascade)
  toCard   Card @relation("toCard", fields: [toCardId], references: [id], onDelete: Cascade)

  @@index([fromCardId])
  @@index([toCardId])
}

model CardTransitionLog {
  id              String    @id @default(cuid())
  cardId          String
  fromState       CardState
  toState         CardState
  triggeredBy     String
  expertSessionId String?
  createdAt       DateTime  @default(now())

  triggeredByUser User           @relation(fields: [triggeredBy], references: [id])
  cardRef         Card           @relation(fields: [cardId], references: [id], onDelete: Cascade)
  expertSession   ExpertSession? @relation(fields: [expertSessionId], references: [id])

  @@index([cardId])
}

model CanvasNode {
  id          String   @id @default(cuid())
  subFolderId String
  nodeId      String
  type        String
  positionX   Float
  positionY   Float
  data        Json     @default("{}")
  labContext  LabType
  updatedAt   DateTime @updatedAt

  subFolder SubFolder @relation(fields: [subFolderId], references: [id], onDelete: Cascade)

  @@unique([subFolderId, nodeId])
  @@index([subFolderId, labContext])
}

model CanvasEdge {
  id          String   @id @default(cuid())
  subFolderId String
  edgeId      String
  source      String
  target      String
  data        Json     @default("{}")
  labContext  LabType
  updatedAt   DateTime @updatedAt

  subFolder SubFolder @relation(fields: [subFolderId], references: [id], onDelete: Cascade)

  @@unique([subFolderId, edgeId])
  @@index([subFolderId, labContext])
}

model Expert {
  id                  String  @id @default(cuid())
  name                String
  slug                String  @unique
  lab                 LabType
  poleId              String?
  systemPrompt        String  @db.Text
  requiredCardTypes   Json    @default("[]")
  blocksLabTransition Boolean @default(false)

  pole     Pole?          @relation(fields: [poleId], references: [id], onDelete: SetNull)
  sessions ExpertSession[]

  @@index([poleId])
}

model Pole {
  id                  String   @id @default(cuid())
  code                PoleCode @unique
  managerName         String
  managerSlug         String   @unique
  systemPrompt        String   @db.Text
  hashtagTriggers     Json     @default("[]")
  activePriorityLabs  Json     @default("[]")
  createdAt           DateTime @default(now())

  experts  Expert[]
  sessions PoleSession[]
}

model Mission {
  id        String   @id @default(cuid())
  dossierId String
  title     String
  goal      String?
  status    String   @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dossier      Dossier       @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  poleSessions PoleSession[]

  @@index([dossierId])
}

model PoleSession {
  id             String            @id @default(cuid())
  poleId         String
  dossierId      String
  missionId      String?
  labAtCreation  LabType           @default(DISCOVERY)
  messages       Json              @default("[]")
  status         PoleSessionStatus @default(ACTIVE)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  pole           Pole           @relation(fields: [poleId], references: [id], onDelete: Cascade)
  dossier        Dossier        @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  mission        Mission?       @relation(fields: [missionId], references: [id], onDelete: SetNull)
  expertSessions ExpertSession[]

  @@index([dossierId])
  @@index([poleId])
  @@index([missionId])
}

model ExpertSession {
  id             String              @id @default(cuid())
  expertId       String
  dossierId      String
  labStateId     String
  poleSessionId  String?
  cardId         String?
  messages       Json                @default("[]")
  status         ExpertSessionStatus @default(PENDING)
  proposedCard   Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  expert         Expert             @relation(fields: [expertId], references: [id])
  dossier        Dossier            @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  labState       LabState           @relation(fields: [labStateId], references: [id])
  poleSession    PoleSession?       @relation(fields: [poleSessionId], references: [id], onDelete: SetNull)
  card           Card?              @relation(fields: [cardId], references: [id])
  transitionLogs CardTransitionLog[]

  @@index([dossierId])
  @@index([expertId])
  @@index([poleSessionId])
}

model KaelSession {
  id             String            @id @default(cuid())
  dossierId      String
  labAtCreation  LabType           @default(DISCOVERY)
  messages       Json              @default("[]")
  status         PoleSessionStatus @default(ACTIVE)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  dossier            Dossier             @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  autonomousMissions AutonomousMission[]

  @@index([dossierId])
}

model AutonomousMission {
  id              String        @id @default(cuid())
  dossierId       String
  kaelSessionId   String
  poleSessionId   String?
  poleCode        String
  managerName     String
  objective       String        @db.Text
  estimatedCost   Int
  actualCost      Int           @default(0)
  status          MissionStatus @default(BRIEFING)
  updates         Json          @default("[]")
  result          Json?
  cascadeFrom     String?
  createdAt       DateTime      @default(now())
  completedAt     DateTime?

  dossier     Dossier     @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  kaelSession KaelSession @relation(fields: [kaelSessionId], references: [id], onDelete: Cascade)
  parent      AutonomousMission?  @relation("MissionCascade", fields: [cascadeFrom], references: [id], onDelete: SetNull)
  children    AutonomousMission[] @relation("MissionCascade")

  @@index([dossierId])
  @@index([kaelSessionId])
  @@index([status])
}

model UserNotificationSettings {
  userId                 String  @id
  missionProgressUpdates Boolean @default(true)
  telegramOnComplete     Boolean @default(true)
  telegramChatId         String?
  telegramLinkedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ScoreSnapshot {
  id              String   @id @default(cuid())
  dossierId       String
  marketScore     Float    @default(0)
  techScore       Float    @default(0)
  financeScore    Float    @default(0)
  validationScore Float    @default(0)
  globalScore     Float    @default(0)
  triggeredBy     String?
  createdAt       DateTime @default(now())

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([dossierId])
}

model ExportRecord {
  id          String      @id @default(cuid())
  dossierId   String      @unique
  state       ExportState @default(LOCKED)
  storageUrl  String?
  generatedAt DateTime?
  createdAt   DateTime    @default(now())

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
}

model CrowdfundingCampaign {
  id              String            @id @default(cuid())
  dossierId       String            @unique
  state           CrowdfundingState @default(LOCKED)
  goal            Float
  raised          Float             @default(0)
  shareToken      String            @unique @default(cuid())
  stripeProductId String?
  closedAt        DateTime?
  createdAt       DateTime          @default(now())

  dossier     Dossier      @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  investments Investment[]

  @@index([shareToken])
}

model Investment {
  id                    String           @id @default(cuid())
  campaignId            String
  investorEmail         String
  amount                Float
  stripePaymentIntentId String           @unique
  status                InvestmentStatus @default(PENDING)
  createdAt             DateTime         @default(now())

  campaign CrowdfundingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  dossierId String?
  action    String
  entity    String
  entityId  String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  dossier Dossier? @relation(fields: [dossierId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([dossierId])
  @@index([entity, entityId])
}

model CardIngestionLog {
  id             String   @id @default(cuid())
  dossierId      String
  messageId      String
  idempotencyKey String   @unique
  result         Json     @default("{}")
  createdAt      DateTime @default(now())

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@unique([dossierId, messageId])
  @@index([idempotencyKey])
}

model ExpertDocument {
  id          String       @id @default(cuid())
  dossierId   String
  type        DocumentType
  title       String
  producedBy  String
  poleCode    String?
  sourceKind  String       // "mission" | "session" | "upload"
  sourceId    String?
  content     Json         @default("{}")
  metadata    Json         @default("{}")
  createdAt   DateTime     @default(now())
  validatedAt DateTime?

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([dossierId])
  @@index([poleCode])
  @@index([type])
}

model Task {
  id               String     @id @default(cuid())
  dossierId        String
  title            String
  description      String?
  status           TaskStatus @default(SUGGESTED)
  origin           String     // "expert" | "mission" | "user" | "kael"
  originId         String?
  assignedPole     String?
  relatedDocuments String[]   @default([])
  relatedCards     String[]   @default([])
  dueDate          DateTime?
  completedAt      DateTime?
  createdAt        DateTime   @default(now())

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([dossierId])
  @@index([status])
}

model CardIngestionJob {
  id        String   @id @default(cuid())
  dossierId String
  messageId String
  userId    String
  payload   Json
  status    String   @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  attempts  Int      @default(0)
  nextRunAt DateTime @default(now())
  createdAt DateTime @default(now())

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([status, nextRunAt])
  @@index([dossierId, messageId])
}

// ─── AI Orchestration Layer ───────────────────────────────────────────────────
// Isolated from core business tables. Used by KAEL and Elena workflows.

model AgentSession {
  id        String   @id @default(uuid())
  userId    String?
  sessionId String   @unique
  source    String
  createdAt DateTime @default(now())

  messages  AgentMessage[]
}

model AgentMessage {
  id        String   @id @default(uuid())
  sessionId String
  role      String
  content   String
  agent     String?
  createdAt DateTime @default(now())

  session   AgentSession @relation(fields: [sessionId], references: [sessionId])
}

// ─── Visual Engine Studio ───────────────────────────────────────────────────
// Isolated product module. It deliberately does not use KAEL missions.

model StudioSession {
  id                String   @id @default(cuid())
  userId            String
  onboardingKey     String?  @unique
  studioProfileId   String?
  identityProfileId String?
  referenceCreationId String?
  presetId          String?

  // MIRAVA Session Builder V1
  builderVersion    Int?
  setPresetId       String?
  lightingPresetId  String?
  builderConfig     Json?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  creations StudioCreation[]
  referenceCreation StudioCreation? @relation("StudioSessionReference", fields: [referenceCreationId], references: [id], onDelete: SetNull)
  lookItems StudioSessionLookItem[]

  @@index([userId, createdAt])
  @@index([referenceCreationId])
}

model StudioSessionLookItem {
  id          String   @id @default(cuid())
  sessionId   String
  category    String
  label       String?
  brand       String?
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session StudioSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assets  StudioSessionLookAsset[]

  @@index([sessionId, position])
}

model StudioSessionLookAsset {
  id          String   @id @default(cuid())
  lookItemId  String
  storagePath String   @unique
  mimeType    String
  bytes       Int
  viewKey     String?
  createdAt   DateTime @default(now())

  lookItem StudioSessionLookItem @relation(fields: [lookItemId], references: [id], onDelete: Cascade)

  @@index([lookItemId, createdAt])
}

model StudioCreation {
  id                       String               @id @default(cuid())
  userId                   String
  dossierId                String?
  studioProfileId          String?
  identityProfileId        String?
  presetId                 String?
  sessionId                String?
  parentCreationId         String?
  shotIndex                Int                  @default(0)
  shotIntent               String?
  sourceResultIndex        Int?
  creativeOptions          Json                 @default("{}")
  status                   StudioCreationStatus @default(DRAFT)
  creativeDirectionSummary String?              @db.Text
  masterPrompt             String?              @db.Text
  negativePrompt           String?              @db.Text
  failureCode              String?
  failureMessage           String?
  creditReservationKey     String?              @unique
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  completedAt              DateTime?

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  dossier  Dossier?             @relation(fields: [dossierId], references: [id], onDelete: SetNull)
  assets   StudioAsset[]
  consent  StudioConsent?
  jobs     StudioJob[]
  ledger   StudioCreditLedger[]
  creditAllocations StudioCreditAllocation[]
  studioProfile StudioProfile? @relation("StudioProfileCreations", fields: [studioProfileId], references: [id], onDelete: SetNull)
  sourceStudioProfile StudioProfile? @relation("StudioProfileSource")
  identityProfile StudioIdentityProfile? @relation(fields: [identityProfileId], references: [id], onDelete: SetNull)
  identityEvaluations StudioIdentityEvaluation[]
  session StudioSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  parentCreation StudioCreation? @relation("StudioCreationLineage", fields: [parentCreationId], references: [id], onDelete: SetNull)
  childCreations StudioCreation[] @relation("StudioCreationLineage")
  referencedBySessions StudioSession[] @relation("StudioSessionReference")

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([dossierId])
  @@index([studioProfileId, createdAt])
  @@index([identityProfileId])
  @@index([sessionId, shotIndex])
  @@unique([sessionId, shotIndex])
  @@index([parentCreationId])
}

model StudioProfile {
  id                       String   @id @default(cuid())
  userId                   String
  sourceCreationId         String?  @unique
  presetId                 String?
  name                     String
  creativeDirectionSummary String?  @db.Text
  masterPrompt             String?  @db.Text
  negativePrompt           String?  @db.Text
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceCreation StudioCreation? @relation("StudioProfileSource", fields: [sourceCreationId], references: [id], onDelete: SetNull)
  creations StudioCreation[] @relation("StudioProfileCreations")

  @@index([userId, createdAt])
}

model StudioIdentityProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  retentionAcceptedAt DateTime
  physicalTraits      Json?
  identityMorphology  Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets StudioIdentityAsset[]
  manifests StudioIdentityManifest[]
  evaluations StudioIdentityEvaluation[]
  creations StudioCreation[]
}

model StudioIdentityManifest {
  id                String   @id @default(cuid())
  identityProfileId String
  userId            String
  schemaVersion     String
  versionHash       String
  assetManifest     Json
  createdAt         DateTime @default(now())

  profile StudioIdentityProfile @relation(fields: [identityProfileId], references: [id], onDelete: Cascade)
  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([identityProfileId, versionHash])
  @@index([userId, createdAt])
}

model StudioIdentityEvaluation {
  id                     String   @id
  creationId             String
  identityProfileId      String
  userId                  String
  frameIndex              Int
  stage                   String
  decision                String
  reasonCode              String
  aggregateSimilarity     Float?
  threshold               Float?
  perReferenceSimilarity  Json
  evaluator               Json
  candidateFace           Json
  identityManifestVersion String
  createdAt                DateTime @default(now())

  creation StudioCreation        @relation(fields: [creationId], references: [id], onDelete: Cascade)
  profile  StudioIdentityProfile @relation(fields: [identityProfileId], references: [id], onDelete: Cascade)
  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([creationId, frameIndex, stage])
  @@index([identityProfileId, createdAt])
  @@index([userId, createdAt])
}

model StudioIdentityAsset {
  id                String   @id @default(cuid())
  identityProfileId String
  userId            String
  viewKey           String?
  faceGeometry      Json?
  storagePath       String   @unique
  mimeType          String
  bytes             Int
  createdAt         DateTime @default(now())

  profile StudioIdentityProfile @relation(fields: [identityProfileId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identityProfileId, createdAt])
  @@index([identityProfileId, viewKey])
  @@index([userId, createdAt])
}

model StudioAsset {
  id         String          @id @default(cuid())
  creationId String
  userId     String
  kind                  StudioAssetKind
  referenceFaceGeometry Json?
  storagePath           String          @unique
  mimeType   String
  bytes      Int
  expiresAt  DateTime?
  deletedAt  DateTime?
  createdAt  DateTime        @default(now())

  creation StudioCreation @relation(fields: [creationId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([creationId, kind])
  @@index([userId, expiresAt])
}

model StudioConsent {
  id                    String   @id @default(cuid())
  creationId            String   @unique
  userId                String
  version               String
  ageConfirmed          Boolean
  rightsConfirmed       Boolean
  privacyAccepted       Boolean
  openaiDisclosureAccepted Boolean
  createdAt             DateTime @default(now())

  creation StudioCreation @relation(fields: [creationId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model StudioConsentEvent {
  id              String   @id @default(cuid())
  userId          String
  purpose         String
  decision        String
  documentVersion String
  locale          String   @default("fr")
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
}

model StudioJob {
  id         String          @id @default(cuid())
  creationId String
  kind       StudioJobKind
  status     StudioJobStatus @default(PENDING)
  attempts   Int             @default(0)
  nextRunAt  DateTime        @default(now())
  lockedAt   DateTime?
  failureCode String?
  provider          String?
  providerTaskId    String?
  providerState     String?
  providerFrameIndex Int?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  creation StudioCreation @relation(fields: [creationId], references: [id], onDelete: Cascade)

  @@index([status, nextRunAt])
  @@index([creationId, kind])
  @@unique([creationId, kind])
}

model StudioCreditLedger {
  id                String                @id
  userId            String
  creationId        String?
  kind              StudioCreditEntryKind
  amount            Int
  balanceAfter      Int
  idempotencyKey    String                @unique
  stripeSessionId   String?               @unique
  metadata          Json                  @default("{}")
  createdAt         DateTime              @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  creation StudioCreation? @relation(fields: [creationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([creationId])
}

model StudioCreditLot {
  id             String              @id @default(cuid())
  userId         String
  kind           StudioCreditLotKind
  originalAmount Int
  remaining      Int
  idempotencyKey String              @unique
  stripeSessionId String?            @unique
  periodStart    DateTime?
  periodEnd      DateTime?
  expiresAt      DateTime?
  rolloverUsedAt DateTime?
  metadata       Json                @default("{}")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocations StudioCreditAllocation[]

  @@index([userId, expiresAt])
  @@index([userId, createdAt])
}

model StudioCreditAllocation {
  id         String                     @id @default(cuid())
  creationId String
  lotId      String
  amount     Int
  state      StudioCreditAllocationState @default(RESERVED)
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt

  creation StudioCreation @relation(fields: [creationId], references: [id], onDelete: Cascade)
  lot      StudioCreditLot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@unique([creationId, lotId])
  @@index([lotId, state])
}

model StudioSubscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?  @unique
  planId               String?
  status               String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  firstPaidAt          DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudioPushSubscription {
  id                String   @id @default(cuid())
  userId            String
  endpoint          String   @unique
  encryptedPayload  String   @db.Text
  locale            String   @default("fr")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
