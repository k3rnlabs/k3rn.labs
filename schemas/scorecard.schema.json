{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Visual Audit Scorecard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "evidence_level",
    "axes",
    "total",
    "ai_fingerprint_score",
    "confidence",
    "ceiling"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_level": {
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "axes": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "weight",
          "score",
          "weighted_score",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "weighted_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "total": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "ai_fingerprint_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "ceiling": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "open_p0": {
      "type": "integer",
      "minimum": 0
    },
    "open_p1": {
      "type": "integer",
      "minimum": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
