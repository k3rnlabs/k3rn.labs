{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Visual Audit Input Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "project",
    "mode",
    "evidence_level",
    "artifacts",
    "limitations"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "product_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_audience": {
          "type": [
            "string",
            "null"
          ]
        },
        "business_goal": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "mode": {
      "enum": [
        "captures",
        "url",
        "repository"
      ]
    },
    "evidence_level": {
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    },
    "repository": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "path",
          "sha256",
          "mime_type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "desktop_capture",
              "mobile_capture",
              "additional_capture",
              "segment",
              "product_context",
              "design_context",
              "technical_evidence"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "mime_type": {
            "type": "string",
            "minLength": 1
          },
          "width_px": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "height_px": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "viewport_width_px": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "readability": {
            "enum": [
              "high",
              "medium",
              "low",
              "unknown"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validated": {
      "type": "boolean"
    }
  }
}
