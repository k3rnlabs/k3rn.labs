{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Remediation Prompt Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "lots"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "lots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "finding_ids",
          "skills",
          "objective",
          "audit_prompt",
          "implementation_prompt",
          "verification_prompt",
          "acceptance_criteria"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^LOT-[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "finding_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "skills": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "audit_prompt": {
            "type": "string",
            "minLength": 1
          },
          "implementation_prompt": {
            "type": "string",
            "minLength": 1
          },
          "verification_prompt": {
            "type": "string",
            "minLength": 1
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
