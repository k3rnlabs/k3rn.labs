{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verification Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verification_id",
    "run_id",
    "items",
    "regressions",
    "verdict"
  ],
  "properties": {
    "verification_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "status",
          "evidence",
          "notes"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "RESOLVED",
              "PARTIALLY_RESOLVED",
              "UNCHANGED",
              "REGRESSED"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "regressions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "new_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verdict": {
      "enum": [
        "PASS",
        "REVISE",
        "BLOCKED",
        "FAIL"
      ]
    }
  }
}
